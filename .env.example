# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (สำหรับเทสในเครื่อง)
# คำสั่ง: cp .env.example .env

# Channel access token จาก LINE Developers Console (Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=

# ปลายทางที่จะส่ง:
#  - แชทส่วนตัว: ใช้ userId ของคุณ (ขึ้นต้นด้วย U...)
#  - กลุ่ม:      ใช้ groupId (ขึ้นต้นด้วย C...)
LINE_TARGET_ID=

# (ไม่บังคับ) ข้อความนำหน้าก่อนหมุดโลเคชั่น
LOCATION_GREETING=🌅 อรุณสวัสดิ์! ตำแหน่งล่าสุดวันนี้

# (ไม่บังคับ) ใช้เป็นพิกัด default เผื่อยังไม่มี location.json
# DEFAULT_LAT=13.7563
# DEFAULT_LNG=100.5018
